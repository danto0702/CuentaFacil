# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
TZ=America/Bogota
APP_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=        # panel (sin estas dos variables el panel corre en modo demo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_API_VERSION=
WA_OUTBOUND_RATE_PER_SEC=20

# IA (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_SETUP=claude-opus-5-5
AI_CONFIDENCE_THRESHOLD=0.8
AI_COST_ALERT_USD_PER_PERIOD=2

# Transcripción
STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
STT_API_KEY=

# Wompi (sandbox hasta autorización)
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# Seguridad
ENCRYPTION_KEY=
SOFFICE_PATH=soffice
ENCRYPTION_KEY_ID=v1
BLIND_INDEX_KEY=

# Operación
SUPPORT_PHONE=
WORKER_CONCURRENCY=4
SOFFICE_TIMEOUT_MS=60000
MAX_DOC_MB=2
RETENTION_MONTHS=24
SENTRY_DSN=
LOG_LEVEL=info
