          "body_text": [["María", "del 1 al 31 de octubre de 2026", "0001 de 2026"]]
        }
      },
      {
        "type": "FOOTER",
        "text": "Responde STOP para no recibir recordatorios"
      },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "QUICK_REPLY",
            "text": "Ver borrador"
          }
        ]
      }
    ]
  },
  {
