{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "PascalIA",
  "version": "1.0.0",
  "color": {
    "yellow": {
      "$value": "#FFC107",
      "$description": "Acción: botones, marcador, nodos"
    },
    "yellow-hover": {
      "$value": "#FFB300"
    },
    "yellow-soft": {
      "$value": "#FFD54F",
      "$description": "Selección de texto"
    },
    "gold-ink": {
      "$value": "#8A6100",
      "$description": "Amarillo legible sobre blanco, solo detalles pequeños"
    },
    "graphite": {
      "$value": "#1F1F1F",
      "$description": "Texto, botón oscuro, resultado y cierre"
    },
    "graphite-deep": {
      "$value": "#181818",
      "$description": "Pie de página"
    },
    "muted": {
      "$value": "#5C5C5C"
    },
    "gray": {
      "$value": "#E9E9E9",
      "$description": "Hairline"
    },
    "cream": {
      "$value": "#FFF8E1"
    },
    "cream-line": {
      "$value": "#F3E7BE"
    },
    "white": {
      "$value": "#FFFFFF"
    },
    "on-dark": {
      "$value": "#CFCFCF"
    },
    "on-dark-line": {
      "$value": "#3A3A3A"
    },
    "error": {
      "$value": "#B3261E"
    }
  },
  "gradient": {
    "brand": {
      "$value": "linear-gradient(135deg, #FFD54F 0%, #FFC107 55%, #FFB300 100%)"
    }
  },
  "shadow": {
    "card": {
      "$value": "0 8px 24px rgba(31,31,31,.08)"
    },
    "brand": {
      "$value": "0 10px 30px -10px rgba(255,193,7,.55)"
    },
    "lift": {
      "$value": "0 22px 48px -18px rgba(31,31,31,.28)"
    },
    "askbar": {
      "$value": "inset 0 0 0 1px #E9E9E9, 0 18px 44px -20px rgba(31,31,31,.25)"
    },
    "device": {
      "$value": "0 30px 60px -30px rgba(31,31,31,.5)"
    },
    "hairline": {
      "$value": "inset 0 0 0 1px #E9E9E9"
    }
  },
  "font": {
    "head": {
      "$value": "Montserrat",
      "weights": [
        600,
        700,
        800
      ],
      "use": "Titulares, etiquetas, botones, cifras (tabular-nums)"
    },
    "body": {
      "$value": "Inter",
      "weights": [
        400,
        500,
        600
      ],
      "use": "Texto corrido, campos, chips"
    }
  },
  "type": {
    "display": {
      "family": "Montserrat",
      "weight": 800,
      "size": "clamp(2.5rem, 6vw, 4.75rem)",
      "lineHeight": 1.05,
      "letterSpacing": "-0.02em",
      "maxWidth": "13ch"
    },
    "headline": {
      "family": "Montserrat",
      "weight": 700,
      "size": "clamp(2rem, 4vw, 3.25rem)",
      "lineHeight": 1.1,
      "letterSpacing": "-0.02em"
    },
    "title": {
      "family": "Montserrat",
      "weight": 700,
      "size": "clamp(1.35rem, 2.2vw, 1.75rem)",
      "lineHeight": 1.2,
      "letterSpacing": "-0.01em"
    },
    "figure": {
      "family": "Montserrat",
      "weight": 800,
      "size": "clamp(2.6rem, 5vw, 4rem)",
      "lineHeight": 1,
      "numeric": "tabular-nums"
    },
    "lead": {
      "family": "Inter",
      "weight": 400,
      "size": "clamp(1.0625rem, 1.6vw, 1.25rem)",
      "lineHeight": 1.65
    },
    "body": {
      "family": "Inter",
      "weight": 400,
      "size": "1.0625rem",
      "lineHeight": 1.65
    },
    "label": {
      "family": "Montserrat",
      "weight": 600,
      "size": "1rem"
    },
    "fine": {
      "family": "Inter",
      "weight": 400,
      "size": "0.875rem"
    }
  },
  "radius": {
    "field": "12px",
    "tile": "14px",
    "inner": "16px",
    "item": "18px",
    "window": "20px",
    "panel": "24px",
    "pill": "999px"
  },
  "space": {
    "1": "8px",
    "2": "12px",
    "3": "22px",
    "4": "36px",
    "5": "64px",
    "section-sm": "72px",
    "section": "104px",
    "wrap": "1200px",
    "gutter": "16px",
    "nav": "72px",
    "nav-scrolled": "60px"
  },
  "motion": {
    "ease": "cubic-bezier(.22, 1, .36, 1)",
    "fast": "200ms",
    "base": "220ms",
    "med": "300ms",
    "reveal": "600ms",
    "mark": "900ms",
    "stagger-words": "80ms",
    "shimmer-cycle": "4s",
    "flower-spin": "60s",
    "pulse": "2s",
    "marquee": "45s"
  },
  "icon": {
    "grid": "24x24",
    "stroke": "currentColor",
    "strokeWidth": 1.85,
    "linecap": "round",
    "linejoin": "round",
    "fill": "none"
  }
}